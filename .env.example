# SC DataPack — Docker Configuration
# =====================================
# Copy this file to .env and set DATA_DIR.

# The single folder that contains your Data.p4k and receives JSON output.
# Drop Data.p4k (and optionally build_manifest.id) into this folder.
# JSON files will appear in DATA_DIR/JSON/ after the pipeline runs.
#
# Windows example: DATA_DIR=C:\SC_Data
# Linux example:   DATA_DIR=/mnt/sc-data
DATA_DIR=./sc-data
