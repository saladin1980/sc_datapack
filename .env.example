# SC DataPack — Docker Configuration
# =====================================
# Copy this file to .env and fill in your paths.
# Used by docker-compose.yml

# Required: path to your Data.p4k (~154 GB — point at your existing game files)
# Windows example: P4K_PATH=C:\Program Files\Roberts Space Industries\StarCitizen\LIVE\Data.p4k
# Linux example:   P4K_PATH=/home/user/.local/share/Star Citizen/LIVE/Data.p4k
P4K_PATH=

# Optional: path to build_manifest.id (sits next to Data.p4k in your SC install)
# Provides the proper version string (e.g. 4.6.0-live.11319298) in JSON meta.
# Leave blank to fall back to Data.p4k modification date.
# MANIFEST_PATH=/path/to/build_manifest.id

# Where to write the output JSON files (created automatically)
# JSON files land in OUTPUT_DIR/JSON/
OUTPUT_DIR=./output
